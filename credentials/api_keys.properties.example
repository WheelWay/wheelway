# ============================================================
# 비밀값 템플릿 — 이 파일을 api_keys.properties 로 복사하고 값을 채운다.
#
#   copy credentials\api_keys.properties.example credentials\api_keys.properties
#
# 복사본(api_keys.properties)은 .gitignore 에 있어 커밋되지 않는다.
# 이 .example 파일만 저장소에 남아, 클론한 사람이 무엇을 채워야 하는지 알려준다.
# ============================================================

# MariaDB 비밀번호
spring.datasource.password=

# 카카오 REST API 키 (JavaScript 키 아님)
# 발급: 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키
# 용도: ① 공사구간 67건의 주소를 좌표로 바꾸는 지오코딩
#       ② 주소·장소 검색(KakaoGeocoder)
#       ③ 버스 구간을 도로 모양으로 그리는 길찾기(apis-navi.kakaomobility.com)
#          — 호스트는 다르지만 같은 키로 되고, 별도 활용신청이 필요 없다(2026-08-22 확인).
#            끄려면 application.properties 의 wheelway.bus-road-path=false
kakao.rest-api-key=

# 카카오 JavaScript 키 (위 REST 키와 다른 키. 같은 앱에서 발급)
# 발급: 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > JavaScript 키
# 용도: 경로 확인 화면(/route.html)의 지도 표시
# 주의: 플랫폼 > Web > 사이트 도메인에 http://localhost:8080 을 등록해야 지도가 뜬다
kakao.js-key=

# 네이버 지도(NCP Maps)
# 발급: NAVER Cloud Platform > Services > Maps > Application 등록
#       Web Dynamic Map + Geocoding 둘 다 체크
#
# client-id     : 지도 SDK(/route-naver.html)와 지오코딩에 모두 쓴다
# client-secret : 지오코딩에만 쓴다. 지도 SDK 는 ID 하나로 동작한다
#
# 주의: Application 의 '서비스 URL' 에 http://localhost:8080 을 등록해야 지도가 뜬다
naver.client-id=
naver.client-secret=

# 공공데이터포털 서비스키 — 저상버스 도착 안내용
# 발급: data.go.kr > 마이페이지 > 오픈API > 인증키 발급현황
#
# 키는 계정당 하나다. 아래 여덟 서비스가 전부 같은 키를 쓴다.
# 다만 서비스마다 '활용신청' 은 따로 해야 한다 — 신청 8번, 키 1개.
#
# [충북 보은] 국토교통부 TAGO — apis.data.go.kr/1613000/...  cityCode=33320
#   TAGO 버스정류소정보  정류장 좌표·nodeid
#   TAGO 버스도착정보    도착 예정 + vehicletp(저상버스/일반차량)  ← 주력
#   TAGO 버스노선정보    노선별 경유 정류장 순서
#   TAGO 버스위치정보    운행 차량 현재 위치 (보조)
#   도시코드 조회는 각 서비스 안의 오퍼레이션이라 따로 신청하지 않는다.
#
# [서울 중구] 서울특별시 TOPIS — ws.bus.go.kr/api/rest/...
#   서울특별시_정류소정보조회    stationinfo   정류장 좌표·arsId·stId
#   서울특별시_버스도착정보조회  arrive        도착 예정 + 저상 여부   ← 주력
#   서울특별시_노선정보조회      busRouteInfo  노선별 경유 정류장 순서
#   서울특별시_버스위치정보조회  buspos        운행 차량 현재 위치 (보조)
#
# 왜 두 벌인가: TAGO 도시코드 138건에 서울이 없다(2026-08-14 실측).
# 광역시는 다 있는데 서울만 빠져 있어서, 주 서비스 지역인 중구를 TAGO 로는 못 한다.
#
# 주의: 같은 키가 '인코딩용' 과 '디코딩용' 두 형태로 나온다. 여기엔 디코딩용을 넣는다.
#   디코딩용 — 코드에서 파라미터를 한 번 더 인코딩할 때 쓴다
#   인코딩용 — URL 에 문자열로 그냥 붙일 때 쓴다
# 스프링의 UriComponentsBuilder·RestClient 는 파라미터를 알아서 인코딩하므로
# 인코딩용을 넣으면 %2B 같은 값이 두 번 인코딩돼 인증이 깨진다.
# 이때 오류가 '키가 등록되지 않았다'(SERVICE_KEY_IS_NOT_REGISTERED_ERROR) 로 떠서
# 활용신청이 잘못된 줄 알고 헤매기 쉽다. 안 되면 인코딩용으로 바꿔 한 번 더 찍어볼 것
tago.service-key=


# ------------------------------------------------------------
# Gemini — 길 안내 도우미(챗봇)가 목적지 이름을 뽑는 데 쓴다.
#
# https://aistudio.google.com 에서 발급한다.
#
# ★ 모델 이름은 여기 두지 않는다. application.properties 의 wheelway.llm-model 이다.
#   비밀값이 아니고, 여기 두면 팀원마다 다른 모델을 쓰게 된다.
#
# ★ 무료 한도는 모델마다 크게 다르고 구글이 공개 문서에서 뺐다.
#   https://aistudio.google.com/rate-limit 에서 프로젝트별로 직접 확인할 것.
#   gemini-3.5-flash-lite  RPM 15 · RPD 500
#   gemini-3.6-flash       RPM  5 · RPD  20   ← 하루 20회라 개발이 불가능하다
#
# 키가 없어도 앱은 뜬다. 챗봇이 규칙 기반으로만 동작한다.
gemini.api-key=
